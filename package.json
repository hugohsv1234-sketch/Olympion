{
  "name": "olympion",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/prepare-engine.mjs && next build && node scripts/pwa-manifest.mjs",
    "start": "node scripts/serve.mjs",
    "postinstall": "node scripts/prepare-engine.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:engine": "node --import tsx scripts/test-engine.ts",
    "puzzles:import": "node scripts/import-puzzles.mjs",
    "puzzles:validate": "node scripts/validate-puzzles.mjs",
    "format": "prettier --write src scripts tests *.json *.ts *.mjs *.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "chess.js": "1.4.0",
    "lucide-react": "0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "22.15.30",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "6.0.1",
    "prettier": "3.6.2",
    "stockfish": "19.0.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
