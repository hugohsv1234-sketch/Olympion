# Ohne Konfiguration bleiben Gasttraining, Bots, Analyse und lokale Profile nutzbar.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Ausschließlich auf dem Server setzen. NIEMALS mit NEXT_PUBLIC_ prefixen.
OLYMPION_RANKING_KEY=YOUR_SERVER_ONLY_RANKING_KEY
# Erst einschalten, wenn custom:samsung in Supabase eingerichtet und getestet ist.
NEXT_PUBLIC_SAMSUNG_AUTH_ENABLED=false
